# Copy to .env and adjust. Every value has a sensible default in src/evallab/config.py.
OLLAMA_HOST=http://localhost:11434
EVALLAB_GENERATOR=qwen2.5:3b
EVALLAB_JUDGE=qwen2.5:3b
EVALLAB_JUDGES=qwen2.5:3b,qwen3:1.7b,llama3.2:1b
EVALLAB_VISION=qwen2.5vl:3b
EVALLAB_EMBED=nomic-embed-text:latest
EVALLAB_NUM_CTX=8192
EVALLAB_TOP_K=4
EVALLAB_CHUNK_SIZE=700
EVALLAB_CHUNK_OVERLAP=100
# DeepEval: no cloud account needed for local runs
DEEPEVAL_TELEMETRY_OPT_OUT=YES
# Ask Ollama for a larger default context window (applies to the /v1 API RAGAS uses)
OLLAMA_CONTEXT_LENGTH=8192
